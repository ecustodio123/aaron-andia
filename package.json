{
  "name": "aaron-andia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:seo": "node scripts/check-seo.mjs",
    "test:publications": "node --test tests/publications.test.mjs",
    "dev:pages": "wrangler pages dev --config wrangler.local.jsonc",
    "check:functions": "wrangler pages functions build --outdir .wrangler/build",
    "db:local": "wrangler d1 execute PUBLICATION_LIMITS --local --config wrangler.local.jsonc --file migrations/d1/0001_publication_download_limits.sql",
    "dev:publications-fixture": "node tests/preview-publications.mjs",
    "validate:publications": "npm run test:publications && npm run lint && npm run typecheck && npm run build && npm run check:functions && npm run check:deployment",
    "check:deployment": "node scripts/check-publications-deployment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
